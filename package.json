{
  "name": "@inventec/dsh-copilot-auth",
  "version": "1.2.27",
  "description": "Copilot 设备码登录注销与模型列表管理，免 API Token，目录兜底不覆盖定制，凭据入内置凭据库。",
  "icon": "./icon.svg",
  "type": "module",
  "license": "MIT",
  "author": "iasi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iasiv5/dsh-copilot-auth.git"
  },
  "main": "./src/host.mjs",
  "exports": {
    ".": "./src/host.mjs",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src/host.mjs",
    "src/shared.mjs",
    "lib/client.js",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "docs/CHANGELOG.md",
    "docs/assets",
    "LICENSE",
    "src/catalog.mjs",
    "src/catalog-registry.mjs",
    "src/catalog-fetch.mjs",
    "src/copilot-models.mjs",
    "src/atomic-json.mjs",
    "src/state.mjs",
    "src/refresh-flow.mjs",
    "src/client-http.mjs",
    "src/runtime-scope.mjs",
    "src/auth-host.mjs",
    "src/auth-flow.mjs",
    "src/model-update.mjs",
    "src/refresh-service.mjs",
    "src/refresh-transaction.mjs",
    "src/catalog-overlay.json",
    "icon.svg"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test",
    "prepack": "npm run build",
    "capture": "node scripts/capture-previews.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "playwright-core": "1.62.1",
    "react": "^18.2.0",
    "yaml": "^2.5.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}

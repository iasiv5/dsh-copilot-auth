{
  "name": "@inventec/dsh-copilot-auth",
  "version": "1.2.4",
  "description": "为内置 Copilot 提供方补设备码登录/注销设置页，预置开箱路由；凭据入内置凭据库，模型目录兜底不覆盖定制。适配 DSH 0.1.7+（settings API 重塑后；≤0.1.5 请用 1.1.x）。",
  "type": "module",
  "license": "MIT",
  "author": "iasi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iasiv5/dsh-copilot-auth.git"
  },
  "main": "./src/host.mjs",
  "exports": {
    ".": "./src/host.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/host.mjs",
    "src/shared.mjs",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "src/catalog.mjs",
    "src/catalog-registry.mjs",
    "src/catalog-fetch.mjs",
    "src/copilot-models.mjs",
    "src/atomic-json.mjs",
    "src/state.mjs",
    "src/refresh-flow.mjs",
    "src/catalog-overlay.json"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "react": "^18.2.0",
    "yaml": "^2.5.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
